tech
    format 28
    TR10
end

version
    version 8.3.660
    description "TR-1um drawing-layer 1um CMOS 2-metal (OpenSUSI)"
end

planes
    well,w
    implant,i
    active,a
    metal1,m1
    metal2,m2
end

types
    well	pwell,pw
    well	nwell,nw
    active	polysilicon,poly,red,p
    active	ndiffusion,ndiff,green
    active	pdiffusion,pdiff,brown
    active	nsdimplant,nsd
    active	psdimplant,psd

    active	ntransistor,nfet
    active	ptransistor,pfet

    active	polycontact,pcontact,polycut,pc
    active	ndcontact,ndiffcut,ndc
    active	pdcontact,pdiffcut,pdc
    active	nsubcontact,nsubcut,nsc
    active	psubcontact,psubcut,psc
    metal1	m2contact,m2cut,m2c,via,v,V1,M1M2_V1
    metal1	genericcontact,gcontact,gc

    metal1	metal1,m1,blue,M1
    metal2	metal2,m2,purple,M2
    metal1	prBoundary,prb
end

contact
    pc		poly	metal1
    ndc		ndiff	metal1
    pdc		pdiff	metal1
    nsc		nsd	metal1
    psc		psd	metal1
    m2c		metal1	metal2
end

compose
    compose	nfet	poly	ndiff
    compose	pfet	poly	pdiff
    paint	pdc	pwell	ndc
    paint	pfet	pwell	nfet
    paint	pdiff	pwell	ndiff
    paint	ndc	nwell	pdc
    paint	nfet	nwell	pfet
    paint	ndiff	nwell	pdiff
end

connect
    nwell,nsc,nsd		nwell,nsc,nsd
    pwell,psc,psd		pwell,psc,psd
    pdc/m1,ndc/m1,psc/m1,nsc/m1,pc/m1,m1,m2c/m1,gc		pdc/m1,ndc/m1,psc/m1,nsc/m1,pc/m1,m1,m2c/m1,gc
    m2,m2c/m2			m2,m2c/m2
    poly,pc/a,nfet,pfet		poly,pc/a,nfet,pfet
    ndiff,ndc/a			psd,psc/a
    pdiff,pdc/a			nsd,nsc/a
    ndiff			ndc
    pdiff			pdc
end

styles
    styletype	mos

    nwell	12
    pwell	13
    poly	1
    ndiff	2
    pdiff	4
    psd		5
    nsd		3

    nfet	2
    pfet	4

    pc		22
    ndc		20
    pdc		32
    nsc		3
    psc		5

    metal1	26
    m2c		31
    metal2	27
    gc		44
end

drc
    # Full TR-1um DRC lives in the KLayout runset (run.drc); these few rules
    # only keep the in-Magic checker roughly aligned (lambda units, 0.5um).
    width ndiff,ndc/a,nfet 6 "N+ active width must be at least 3.0um (AA.W1)"
    width pdiff,pdc/a,pfet 6 "P+ active width must be at least 3.0um (AA.W1)"
    width poly,pc/a,nfet,pfet 2 "Gate width must be at least 1.0um (GC.W1)"
    spacing poly,pc/a ~(poly,pc)/a 3 touching_illegal "Gate spacing must be at least 1.5um (GC.S1)"
    width metal1 2 "M1 width must be at least 1.0um (M1.W1)"
    spacing metal1 ~(metal1)/m1 3 touching_ok "M1 spacing must be at least 1.5um (M1.S1)"
    width metal2 2 "M2 width must be at least 1.0um (M2.W1)"
    spacing metal2 ~(metal2)/m2 4 touching_ok "M2 spacing must be at least 2.0um (M2.S1)"
end

cifoutput
style TR10
    scalefactor 100 100

    layer CWN nwell
 labels nwell
 calma 140 0
    layer APd pdiff,pdc/a,pfet
 labels pdiff,pfet
 calma 3 1
    layer ANd ndiff,ndc/a,nfet
 labels ndiff,nfet
 calma 3 2
    layer CAA nsd,nsc/a,psd,psc/a
 labels nsd,psd
 calma 3 3
    layer GCp poly,pc/a,nfet,pfet
 labels poly,nfet,pfet
 calma 8 1
    layer COc ndc/a,pdc/a,pc/a,nsc/a,psc/a
 calma 11 0
    layer CMF m1,m2c/m1,gc
 labels m1
 calma 13 0
    layer CV1 m2c
    # CIF distances are centimicrons: 1.4um V1 cuts, 1.5um cut spacing.
    # Extresist also needs these dimensions to count vertical contacts.
        squares 0 140 150
 calma 19 0
    layer CMS m2,m2c/m2
 labels m2
 calma 20 0
end

cifinput
style TR10
    scalefactor 100

    layer nwell CWN
 labels CWN
    layer ndiff ANd
 labels ANd
    layer pdiff APd
 labels APd
    layer ndiff CAA
 labels CAA
    layer pdiff CAA
 labels CAA
    layer poly GCp
 labels GCp
    layer nsc COc
        and CMF
        and ANd
    layer psc COc
        and CMF
        and APd
    layer pc COc
        and CMF
        and GCp
    layer ndc COc
        and CMF
        and ANd
    layer pdc COc
        and CMF
        and APd
    layer nfet GCp
        and ANd
    layer pfet GCp
        and APd
    layer m1 CMF
 labels CMF
    layer m2c CV1
        and CMF
        and CMS
    layer m2 CMS
 labels CMS

    calma CWN 140 *
    calma APd 3 1
    calma ANd 3 2
    calma CAA 3 3
    calma GCp 8 1
    calma COc 11 *
    calma CMF 13 *
    calma CV1 19 *
    calma CMS 20 *
    calma GCp 8 *
    calma CMF 235 4
    calma CMF 48 *
    calma CMS 49 *
end

extract
    style TR10
    cscale 1
    lambda 100
    step 100
    sidehalo 0
    planeorder implant 0
    planeorder well 1
    planeorder active 2
    planeorder metal1 3
    planeorder metal2 4
    resist metal1 50
    resist metal2 30
    resist m2c 1000
    # Explicit vertical V1 uses the existing tech LEF 1-ohm/cut engineering prior.
    # Sheet resistance alone does not define vertical contact resistance.
    contact m2c 1000
    areacap (ndiff,ndc)/a 30
    perimc (ndiff,ndc)/a space,pw 40
    areacap (pdiff,pdc)/a 30
    perimc (pdiff,pdc)/a space,nw 40
    areacap (poly,pc)/a 39
    perimc (poly,pc)/a ~(poly,pc)/a 80
    areacap metal1/m1 35
    perimc metal1/m1 ~(metal1)/m1 50
    areacap metal2/m2 18
    perimc metal2/m2 ~(metal2)/m2 50
    sideoverlap metal1/m1 ~(metal1)/m1 metal2/m2 20
    sideoverlap metal2/m2 ~(metal2)/m2 metal1/m1 20
    overlap metal2/m2 metal1/m1 20
    device mosfet nfet nfet ndiff,ndc pwell Gnd! 150 450
    device mosfet pfet pfet pdiff,pdc nwell Vdd! 204 450
end
