# Basic check for layer polygons
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Original version was made by jun1okamura from TokaiRika's document 
# LICENSE: Apache License Version 2.0, January 2004,
#          http://www.apache.org/licenses/
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Drain connected to Backgate
#
(SPE.not_interacting(antenna_check(GP, CO, 0.0))).output("Warning: ESD PMOS source not connected to well tap")
(SNE.not_interacting(antenna_check(GN, CO, 0.0))).output("Warning: ESD NMOS source not connected to sub tap")
COS  = CO & ( SPE + SNE )
COD  = CO & ( DPE + DNE )
COD_s = COD.drc((space(projection) <= 1.6).polygons) # Requires width and space from DRM
COS_s = COS.drc((space(projection) <= 1.6).polygons) # Requires width and space from DRM
# end of row diffusion contacts. enclosure is half max enclosure allowed without adding another CO
# DRM calculates to 4.8um, but actual layout is 5.1um, so add 0.3um fudge factor
COD_e = COD.edges.enclosed(AME_h, 2.5+(1.6+3.0)/2+0.3+1.dbu, projection).polygons
COS_e = COS.edges.enclosed(AME_h, 2.5+(1.6+3.0)/2+0.3+1.dbu, projection).polygons

GC_ext3 = GA.edges.inside_part(AME).extended_out(3.0).edges.inside_part(SPE + SNE)
GC_ext7 = GA.edges.inside_part(AME).extended_out(7.0).edges.inside_part(DPE + DNE)
# COS.output("SOURCE")      # DEBUG
# COD.output("DRAIN")       # DEBUG
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Gate electrically connected to Substrate
#
connect(AR, CO) # short diffusion resistors for substrate connection checks
connect(GR, CO) # short poly resistors for substrate connection checks
#
GC_MP = antenna_check(SDP,  GC, 0.0)
GC_MN = antenna_check(SDN,  GC, 0.0)
GC_PE = antenna_check(SDPE, GC, 0.0)
GC_NE = antenna_check(SDNE, GC, 0.0)
GC_DP = antenna_check(DP,   GC, 0.0)
GC_DN = antenna_check(DN,   GC, 0.0)
GC_GP = antenna_check(GP,   GC, 0.0)
GC_GN = antenna_check(GN,   GC, 0.0)
GC_PAD = antenna_check(M2P, GC, 0.0)
#
GC_FL = (GC - (GC_MP + GC_MN + GC_PE + GC_NE + GC_DP + GC_DN + GC_GP + GC_GN))  # Floating Gate
#
# Select Top
#
TOPCELL = layout.cell_name
if SCRB.is_empty?
    source_topcell  = source.select("-*", "+#{TOPCELL}")
else
    source_topcell = source.select("-*")
end
#
# NETLIST_LABELS_REQUIRED: the signoff wrapper must compare these top labels
# with the exact netlist interface using check_netlist_labels.py.
# Select Top Metal Labels
#
M1LBL_TOP = source_topcell.labels(48, 0).texts(as_boxes)  # Top M1 Label
M2LBL_TOP = source_topcell.labels(49, 0).texts(as_boxes)  # Top M2 Label
#
# Top Pins and labels connection
#
connect(M1,   M1LBL_TOP)  # Attaches M1 top labels
connect(M2,   M2LBL_TOP)  # Attaches M2 top labels
#
# Gate electrically connected to Substrate
#
GC_M1LBL_TOP = antenna_check(M1LBL_TOP, GC, 0.0)
GC_M2LBL_TOP = antenna_check(M2LBL_TOP, GC, 0.0)
#
GC_FL_LBL_TOP = (GC - (GC_MP + GC_MN + GC_PE + GC_NE + GC_DP + GC_DN + GC_GP + GC_GN + GC_M1LBL_TOP + GC_M2LBL_TOP + GC_PAD))  # Floating Gate
#
# A gate that reaches no S/D, backgate, well/substrate tap, pad, or top label
# is electrically floating. Report it; a floating oxide is an ESD/reliability
# hazard and was previously computed but never emitted.
GC_FL_LBL_TOP.output("ERC_FLOATING_GATE:gate poly not connected to any diffusion, tap, pad, or top label")

# Project-owned voltage-domain annotations.
#
# V15_MARKER (240/0) and V27_MARKER (241/0) are intentionally separate from
# foundry mask layers.  When present, they annotate the NW/M1 regions that
# carry the corresponding electrical domain.  No marker means no inferred
# voltage class; the annotation must be supplied for these checks to apply.
V15V_NW = NW.interacting(V15_MARKER)
V15V_NW_NORMAL = NW - V15V_NW
V15V_NW.drc(sep(V15V_NW_NORMAL) < 3.5).output(
    "V15V_NW:15 V NW-to-normal-NW spacing < 3.5 um"
)
V27V_PWELL = NW.interacting(V27_MARKER)
V27V_PWELL.drc(sep(WP) < 5.0).output(
    "V27V_PWELL:27 V NW-to-Pwell spacing < 5.0 um"
)
V27V_PWELL.interacting(WP).output(
    "V27V_PWELL:27 V NW island overlaps Pwell"
)
V15V_M1_WIDTH = M1.interacting(V15_MARKER)
V15V_M1_WIDTH.drc(width(projection) < 2.0).output(
    "V15V_M1_WIDTH:15 V power M1 width < 2.0 um"
)
V15_MARKER.not_interacting(NW + M1).output(
    "V15V_MARKER:15 V marker does not annotate NW or M1"
)
V27_MARKER.not_interacting(NW).output(
    "V27V_MARKER:27 V marker does not annotate NW"
)

# ----- ------ ----- ----- ------ ----- ----- ------ -----
# ERC additions: floating well/bulk and HV domain crossing.
# ----- ------ ----- ----- ------ ----- ----- ------ -----
#
# An N-well island that hosts a PMOS but has no GP (P+ backgate) contact is a
# floating bulk: its body is unreachable and the device is a latch-up /
# leakage hazard. WN is the PMOS well; GP is the only conductor that ties it
# to a supply, so an island with PMOS and no GP contact cannot be biased.
WN_WITH_MOS = WN.interacting(MP + MPE)
WN_UNTIED   = WN_WITH_MOS.not_interacting(GP)
WN_UNTIED.output(
    "ERC_FLOATING_NWELL:N-well hosts a PMOS but has no P+ backgate (GP) tie contact"
)
#
# Complementary check: a P-well/substrate region hosting an NMOS must reach a
# GN (N+ backgate) contact. GN is globally tied to VSS, so an NMOS whose
# surrounding P-well has no GN contact is left floating.
WP_WITH_MOS = WP.interacting(MN + MNE)
WP_UNTIED   = WP_WITH_MOS.not_interacting(GN)
WP_UNTIED.output(
    "ERC_FLOATING_PWELL:P-well hosts an NMOS but has no N+ backgate (GN) tie contact"
)
#
# Overvoltage: a 15 V or 27 V annotated NW must not abut an un-annotated NW at
# a spacing tighter than the domain rule already encoded above; additionally
# flag an annotated NW that directly touches a normal NW (zero spacing is a
# hard domain short, not just a spacing violation).
V15V_NW.interacting(V15V_NW_NORMAL).output(
    "ERC_HV_SHORT:15 V N-well directly abuts a normal-voltage N-well"
)
V27V_PWELL.interacting(NW - V27V_PWELL).output(
    "ERC_HV_SHORT:27 V N-well directly abuts a normal-voltage N-well"
)

# ----- ------ ----- ----- ------ ----- ----- ------ -----
# EMIR proxy (geometric only -- this deck has no current data).
#
# A single via feeding a wide metal stripe is a current-crowding /
# electromigration bottleneck: the via carries the stripe's full current.
# Select the *wide* M2 stripes first (width >= ~6um), then flag those that
# are fed by fewer than two vias -- a wide strap needs parallel vias to
# share the current.  A narrow wire that is itself under a via is not the
# target and is left out.
#
# NOTE: geometric screening heuristic only -- no netlist/current model, so
# this reports a *suspect* wide-strap region, not a measured current
# density.  Treat as an informational warning for engineering review; do
# not raise to a blocking DRC failure without a current source.
# Isolate the *wide* M2 stripes: M2 polygons wider than ~4um (the routing
# minimum is 3.0um).  width(projection) <= 4.0 selects the narrow polygons;
# subtracting them leaves the wide straps.  (width > N alone does not
# select the parent polygon reliably, so use the complement.)
# These two checks are geometric heuristics with no current model; by their
# own definition they must not gate signoff.  They are OFF by default and can
# be enabled for engineering review with `-rd emir_check=1` (or
# KLAYOUT_DRC_OPTIONS = {"emir_check": 1}).  Undefined runset options evaluate
# false in KLayout, so this stays a no-op for every normal invocation.
if $emir_check
    M2_NARROW  = M2.drc(width(projection) <= 4.0).polygons
    M2_WIDE    = M2 - M2_NARROW                        # stripes wider than ~4um
    # A wide stripe is adequately fed when vias are spaced along it; a single
    # via leaves a long un-fed span.  Grow each via by the via-pitch reach
    # (~4um): the part of a wide stripe NOT within reach of any via is the
    # current-starved section.  Report wide-stripe area that is via-starved.
    V1_REACH  = V1.sized(4.0)                         # each via feeds ~4um around it
    M2_WIDE_STARVED = M2_WIDE - V1_REACH              # wide stripe out of via reach
    M2_WIDE_STARVED.output(
        "EMIR_VIA_CROWDING:wide M2 stripe fed by too few vias (possible current bottleneck; informational)"
    )
    # A narrow M1 segment carrying a wide M2 down is the same bottleneck in M1.
    M1_NARROW = M1.drc(width(projection) < 1.2).polygons
    (M1_NARROW & V1.sized(0.5)).output(
        "EMIR_M1_NECK:narrow M1 segment under a via (possible current bottleneck)"
    )
end
