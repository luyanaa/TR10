# Run mode {deep(default), flat}
if $run_mode == 'flat'
    puts("Setting running mode => flat")
    flat
else
    puts("Setting running mode => deep")
    deep          # Hierarchical extraction
end
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Define Top Cell
if $input 
    if $top_cell
        source($input, $top_cell)
    else
        source($input)
    end
end
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Extract Netlist Only
if $netlist_only
    NET_ONLY = true
else
    NET_ONLY = false
end
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Output report(lvsdb) file
if $report
    report_lvs($report)
else
    report_lvs    # LVS report window
end
# Top-level ports are always checked in comparison mode.
