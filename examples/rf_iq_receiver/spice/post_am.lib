* Post-layout AM-chain modules (hybrid PEX).
* Pre-layout device netlists + Magic PEX node capacitances on the
* LVS-verified nets; generated by scripts/gen_post_am.py -- do not edit.

.subckt RX_LNA in out vdd vss agc
.param fc=1e6 q=20
.param wc = 2*3.141592653589793*fc
.param Lval = 15.9u*1e6/fc
.param Cval = 1/(wc*wc*Lval)
.param Rp = q*wc*Lval

* 50 ohm input termination and AC coupling
Rterm in vss 50
Cin in g 100n

* AGC: gate bias 0.77 V (60 uA) .. 1.35 V (2 mA), bypassed to AC ground
Bv vg vss V = {0.77 + 0.116*v(agc)}
Rg vg g 100k

* common-source gain stage, grounded source
X1 d g vss vss NMOS_nf w=200u l=1u nf=10 rgval=1

* ideal parallel tank at fc
Lt d vdd {Lval}
Ct d vdd {Cval}
Rp d vdd {Rp}

* source-follower buffer, 4 mA
X2 vdd d out vss NMOS_nf w=200u l=1u nf=10 rgval=1
Ibuf out vss dc 4m
* ---- Magic PEX parasitics (layout/pex/rx_lna.spice) ----
Cpex0 d g 0.2736f
Cpex1 vss out 0.2736f
Cpex2 d vdd 0.2736f
Cpex3 vss d 0.2736f
Cpex4 vss vdd 0.2736f
Cpex5 g 0 29.5426f
Cpex6 vdd 0 42.1541f
Cpex7 out 0 54.5095f
Cpex8 d 0 73.62211f
Cpex9 vss 0 62.5193f
.ends RX_LNA

.subckt RX_MIXER rf_p rf_n lo0 lo90 lo180 lo270 out_i out_q vdd vss
X0 out_i lo0 rf_p vss NMOS_nf w=200u l=1u nf=10 rgval=1
X1 out_i lo180 rf_n vss NMOS_nf w=200u l=1u nf=10 rgval=1
X2 out_q lo90 rf_p vss NMOS_nf w=200u l=1u nf=10 rgval=1
X3 out_q lo270 rf_n vss NMOS_nf w=200u l=1u nf=10 rgval=1
* ---- Magic PEX parasitics (layout/pex/rx_mixer.spice) ----
Cpex0 rf_p lo180 0.2736f
Cpex1 lo270 rf_n 0.2736f
Cpex2 out_q rf_p 0.2736f
Cpex3 rf_n out_q 0.5472f
Cpex4 out_q lo90 0.2736f
Cpex5 rf_n rf_p 0.2736f
Cpex6 out_i lo0 0.2736f
Cpex7 lo90 rf_p 0.2736f
Cpex8 rf_p out_i 0.2736f
Cpex9 rf_n lo90 0.2736f
Cpex10 lo0 0 29.5426f
Cpex11 out_i 0 79.1536f
Cpex12 lo180 0 32.2546f
Cpex13 rf_p 0 0.11185p
Cpex14 lo90 0 36.3226f
Cpex15 out_q 0 92.9599f
Cpex16 rf_n 0 0.11728p
Cpex17 lo270 0 37.6786f
Cpex18 vss 0 14.4872f
.ends RX_MIXER

.subckt RX_TIA in out vdd vss
.param rf=10k cf=3.5n ibias=2m
X1 out in vss vss NMOS_nf w=200u l=1u nf=10 rgval=1
Iload vdd out dc {ibias}
Rf out in {rf}
Cf out in {cf}
* ---- Magic PEX parasitics (layout/pex/rx_tia.spice) ----
Cpex0 out 0 46.2074f
Cpex1 in 0 39.1024f
Cpex2 vss 0 53.2895f
.ends RX_TIA

.subckt RX_AM_DEMOD i_in q_in out vdd vss
.param itail=500u rload=10k cload=3.5n

* ---- 1.55 V reference (matches the TIA output DC bias) -----------------
* A divider, not an RC average: the 1 ms verification transient is far
* shorter than the 10 ms time constant of a 16 Hz RC average.
Rref1 vdd bi 6.9k
Rref2 bi vss 3.1k
Rrefq1 vdd bq 6.9k
Rrefq2 bq vss 3.1k

* ---- 16 kHz anti-alias filters ----------------------------------------
Rfi i_in ii 1k
Cfi ii vss 10n
Rfq q_in qq 1k
Cfq qq vss 10n

* ---- I-channel half-wave rectifier ------------------------------------
X1 d1 ii tail vss NMOS_nf w=100u l=1u nf=4 rgval=1
X2 d2 bi tail vss NMOS_nf w=100u l=1u nf=4 rgval=1
Itail tail vss dc {itail}
* PMOS mirror: copy the input-branch current into the reference branch
X3 d1 d1 vdd vdd PMOS_nf w=50u l=2u nf=4 rgval=1
X4 d2 d1 vdd vdd PMOS_nf w=50u l=2u nf=4 rgval=1
* clamp the negative half, mirror the positive half to the output
X5 d2 d2 vss vss NMOS_nf w=100u l=1u nf=4 rgval=1
X6 out d2 vss vss NMOS_nf w=100u l=1u nf=4 rgval=1

* ---- Q-channel half-wave rectifier, summed at out ---------------------
X7 d3 qq tailq vss NMOS_nf w=100u l=1u nf=4 rgval=1
X8 d4 bq tailq vss NMOS_nf w=100u l=1u nf=4 rgval=1
Itailq tailq vss dc {itail}
X9 d3 d3 vdd vdd PMOS_nf w=50u l=2u nf=4 rgval=1
X10 d4 d3 vdd vdd PMOS_nf w=50u l=2u nf=4 rgval=1
X11 d4 d4 vss vss NMOS_nf w=100u l=1u nf=4 rgval=1
X12 out d4 vss vss NMOS_nf w=100u l=1u nf=4 rgval=1

* ---- shared output load / audio low-pass ------------------------------
Rload out vdd {rload}
Cload out vss {cload}
* ---- Magic PEX parasitics (layout/pex/rx_amdemod.spice) ----
Cpex0 d2 tail 0.2736f
Cpex1 vss d2 0.2736f
Cpex2 vdd d3 1.0944f
Cpex3 d3 tailq 0.5472f
Cpex4 d1 bi 0.2736f
Cpex5 d4 d3 0.5472f
Cpex6 d3 qq 0.2736f
Cpex7 vss bq 0.2736f
Cpex8 out vdd 0.2736f
Cpex9 out tailq 0.5472f
Cpex10 d4 out 1.0944f
Cpex11 out qq 0.2736f
Cpex12 d2 bi 0.2736f
Cpex13 vdd d1 0.2736f
Cpex14 d3 bq 0.2736f
Cpex15 vdd tailq 0.5472f
Cpex16 out d2 0.2736f
Cpex17 vss d3 1.0944f
Cpex18 d4 vdd 0.5472f
Cpex19 vdd qq 0.2736f
Cpex20 bi tail 0.2736f
Cpex21 d4 tailq 0.2736f
Cpex22 out bq 0.2736f
Cpex23 vss out 0.5472f
Cpex24 d2 d1 0.5472f
Cpex25 vdd d2 0.5472f
Cpex26 d1 tail 0.5472f
Cpex27 vdd bq 0.2736f
Cpex28 vss vdd 0.5472f
Cpex29 d1 ii 0.2736f
Cpex30 bq tailq 0.2736f
Cpex31 vss tailq 0.5472f
Cpex32 d4 bq 0.2736f
Cpex33 vss d4 1.368f
Cpex34 out d3 1.0944f
Cpex35 vss qq 0.2736f
Cpex36 ii 0 19.5986f
Cpex37 tail 0 72.76421f
Cpex38 bi 0 23.6666f
Cpex39 d1 0 97.3863f
Cpex40 d2 0 0.14571p
Cpex41 qq 0 30.4466f
Cpex42 tailq 0 94.46021f
Cpex43 bq 0 34.5146f
Cpex44 d3 0 0.14102p
Cpex45 vdd 0 0.16369p
Cpex46 out 0 0.10511p
Cpex47 d4 0 0.20094p
Cpex48 vss 0 0.20796p
.ends RX_AM_DEMOD

